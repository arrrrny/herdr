# Fork-owned files for arrrrny/herdr.
#
# Each line is `<path>  ::  <marker>`. The sync-upstream workflow greps
# `<path>` for `<marker>` after every clean merge. If the marker is gone,
# upstream silently overwrote a fork-owned feature and the sync fails.
#
# Add an entry every time you change a fork-owned file. Pick a marker
# that is unique enough that a clean upstream edit cannot accidentally
# remove it. Issue references (e.g. `arrrrny/herdr#1`) work well because
# upstream does not know about the fork's issue tracker.

# macOS notification click -> focus pane (arrrrny/herdr#27, #34)
src/cli/notification_click.rs                ::  arrrrny/herdr#27

# login-shell PATH for custom commands / integrations (arrrrny/herdr#4)
src/app/runtime.rs                            ::  arrrrny/herdr#4
src/app/input/navigate.rs                     ::  arrrrny/herdr#12
src/integration/registry.rs                   ::  arrrrny/herdr#4
src/integration/env.rs                        ::  arrrrny/herdr#4

# Agent lifecycle / lowered state from pane report-agent (arrrrny/herdr#1, #9)
src/terminal/state.rs                         ::  arrrrny/herdr#1
src/pane.rs                                   ::  arrrrny/herdr#1

# macOS terminal-notifier click target marker (arrrrny/herdr#34)
src/platform/macos.rs                         ::  arrrrny/herdr#34

